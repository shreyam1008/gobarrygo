---
const repoUrl = "https://github.com/shreyam1008/gobarrygo";
const legacyVersion = "v0.0.9";
const legacyReleaseUrl = `${repoUrl}/releases/tag/${legacyVersion}`;
const legacyDownloadBase = `${repoUrl}/releases/download/${legacyVersion}`;
const protoPeekUrl = "https://protopeek.shreyam1008.com.np/downloader/";
const migrationGuideUrl = `${repoUrl}/blob/main/docs/migrating-to-protopeek.md`;
const canonicalMigrationGuideUrl =
  "https://github.com/shreyam1008/ProtoPeek/blob/master/guides/gobarrygo-consolidation.md";
const authorUrl = "https://shreyam1008.com.np/";
const siteTitle = "GoBarryGo has moved to ProtoPeek Downloader";
const siteDescription =
  "GoBarryGo's continued development has moved into ProtoPeek v0.5 Downloader. Standalone v0.0.9 downloads, checksums, source, and migration help remain available.";
const baseUrl = import.meta.env.BASE_URL;
const siteUrl = new URL(baseUrl, Astro.site).toString();
const faviconUrl = `${baseUrl}favicon.svg`.replace(/\/{2,}/g, "/");

const legacyDownloads = [
  { platform: "Linux", label: "Debian / Ubuntu package", file: "gobarrygo.deb", size: "10 MB" },
  { platform: "Linux", label: "Fedora / RHEL package", file: "gobarrygo.rpm", size: "10 MB" },
  { platform: "Linux", label: "AppImage", file: "gobarrygo-amd64.AppImage", size: "82 MB" },
  { platform: "Linux", label: "Standalone binary", file: "gobarrygo-linux-amd64", size: "25 MB" },
  { platform: "Windows", label: "Installer", file: "gobarrygo-amd64-installer.exe", size: "8.8 MB" },
  { platform: "Windows", label: "Portable executable", file: "gobarrygo.exe", size: "17 MB" },
  { platform: "macOS", label: "Application ZIP", file: "gobarrygo-macos.zip", size: "5 MB" },
];

const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebPage",
      "@id": siteUrl,
      url: siteUrl,
      name: siteTitle,
      description: siteDescription,
      about: { "@id": `${siteUrl}#legacy-software` },
      author: { "@id": `${authorUrl}#person` },
    },
    {
      "@type": "SoftwareApplication",
      "@id": `${siteUrl}#legacy-software`,
      name: "GoBarryGo",
      alternateName: "GoBarryGo standalone",
      applicationCategory: "UtilitiesApplication",
      applicationSubCategory: "Legacy native download manager",
      operatingSystem: "Linux, macOS, Windows",
      softwareVersion: "0.0.9",
      description:
        "Preserved standalone GoBarryGo release. Continued downloader development is now part of ProtoPeek.",
      url: siteUrl,
      downloadUrl: legacyReleaseUrl,
      codeRepository: repoUrl,
      license: "https://opensource.org/licenses/MIT",
      isAccessibleForFree: true,
      offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
      isPartOf: {
        "@type": "SoftwareApplication",
        name: "ProtoPeek",
        softwareVersion: "0.5.0",
        url: protoPeekUrl,
      },
      author: { "@id": `${authorUrl}#person` },
    },
    {
      "@type": "Person",
      "@id": `${authorUrl}#person`,
      name: "Shreyam Adhikari",
      alternateName: "shreyam1008",
      url: authorUrl,
      sameAs: ["https://github.com/shreyam1008", authorUrl],
    },
  ],
};
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href={faviconUrl} />
    <link rel="canonical" href={siteUrl} />
    <meta name="generator" content={Astro.generator} />

    <title>{siteTitle}</title>
    <meta name="description" content={siteDescription} />
    <meta
      name="keywords"
      content="GoBarryGo, ProtoPeek Downloader, aria2c, download manager, migration, legacy release, Shreyam Adhikari, shreyam1008"
    />
    <meta name="author" content="Shreyam Adhikari (shreyam1008)" />
    <meta name="robots" content="index, follow" />
    <meta name="google-site-verification" content="nsLMV5dqPB3vxpuq7DPX9iBtRAikKDpxEUJNvMnriTk" />
    <meta name="theme-color" content="#07111f" />

    <meta property="og:type" content="website" />
    <meta property="og:url" content={siteUrl} />
    <meta property="og:title" content={siteTitle} />
    <meta property="og:description" content={siteDescription} />
    <meta property="og:site_name" content="GoBarryGo" />
    <meta property="og:locale" content="en_US" />

    <meta name="twitter:card" content="summary" />
    <meta name="twitter:url" content={siteUrl} />
    <meta name="twitter:title" content={siteTitle} />
    <meta name="twitter:description" content={siteDescription} />

    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />

    <style>
      :root {
        color-scheme: dark;
        --bg: #07111f;
        --surface: #0c1a2b;
        --surface-strong: #11243a;
        --ink: #f4f7fb;
        --muted: #a7b4c4;
        --line: #22364d;
        --brand: #4fd1c5;
        --brand-strong: #81e6d9;
        --blue: #73a8ff;
        --legacy: #f8d57e;
      }

      * { box-sizing: border-box; }
      html { scroll-behavior: smooth; }
      body {
        margin: 0;
        min-width: 320px;
        background:
          radial-gradient(circle at 12% -12%, rgba(79, 209, 197, 0.16), transparent 34rem),
          radial-gradient(circle at 92% 8%, rgba(115, 168, 255, 0.15), transparent 30rem),
          var(--bg);
        color: var(--ink);
        font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
        line-height: 1.6;
        -webkit-font-smoothing: antialiased;
      }

      a { color: var(--brand-strong); text-underline-offset: 0.2em; }
      a:hover { color: #b7fff6; }
      code { font-family: "SFMono-Regular", Consolas, "Liberation Mono", monospace; }

      .shell { width: min(70rem, calc(100% - 2rem)); margin: 0 auto; }
      .topbar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        min-height: 4.25rem;
        border-bottom: 1px solid var(--line);
      }
      .brand { color: var(--ink); font-weight: 800; letter-spacing: -0.03em; text-decoration: none; }
      .topbar-links { display: flex; flex-wrap: wrap; gap: 1rem; font-size: 0.86rem; }

      main { padding: 5rem 0 4rem; }
      .hero { display: grid; gap: 2rem; max-width: 58rem; }
      .eyebrow {
        display: inline-flex;
        width: fit-content;
        align-items: center;
        gap: 0.5rem;
        padding: 0.35rem 0.7rem;
        border: 1px solid rgba(248, 213, 126, 0.35);
        border-radius: 999px;
        background: rgba(248, 213, 126, 0.08);
        color: var(--legacy);
        font-size: 0.75rem;
        font-weight: 700;
        letter-spacing: 0.08em;
        text-transform: uppercase;
      }
      h1 {
        max-width: 15ch;
        margin: 0;
        font-size: clamp(2.7rem, 8vw, 6.5rem);
        line-height: 0.96;
        letter-spacing: -0.065em;
      }
      .lede { max-width: 44rem; margin: 0; color: var(--muted); font-size: clamp(1.05rem, 2vw, 1.3rem); }
      .lede strong { color: var(--ink); }
      .actions { display: flex; flex-wrap: wrap; gap: 0.75rem; }
      .button {
        display: inline-flex;
        min-height: 2.85rem;
        align-items: center;
        justify-content: center;
        padding: 0.7rem 1rem;
        border: 1px solid var(--line);
        border-radius: 0.7rem;
        background: var(--surface);
        color: var(--ink);
        font-size: 0.9rem;
        font-weight: 700;
        text-decoration: none;
      }
      .button:hover { border-color: var(--brand); background: var(--surface-strong); color: var(--ink); }
      .button-primary { border-color: transparent; background: var(--brand); color: #05221f; }
      .button-primary:hover { border-color: transparent; background: var(--brand-strong); color: #05221f; }

      .continuity {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 1px;
        margin-top: 4rem;
        overflow: hidden;
        border: 1px solid var(--line);
        border-radius: 1rem;
        background: var(--line);
      }
      .continuity article { background: var(--surface); padding: 1.25rem; }
      .continuity span { color: var(--brand); font-size: 0.75rem; font-weight: 800; letter-spacing: 0.08em; text-transform: uppercase; }
      .continuity h2 { margin: 0.35rem 0; font-size: 1rem; }
      .continuity p { margin: 0; color: var(--muted); font-size: 0.87rem; }

      section { padding: 4.5rem 0 0; }
      .section-head { display: grid; grid-template-columns: minmax(0, 0.8fr) minmax(18rem, 1fr); gap: 2rem; align-items: end; }
      .section-head h2 { margin: 0; font-size: clamp(1.8rem, 4vw, 2.7rem); letter-spacing: -0.04em; }
      .section-head p { margin: 0; color: var(--muted); }

      .steps { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1rem; margin-top: 2rem; }
      .step { border-left: 2px solid var(--brand); padding: 0.4rem 1rem 0.6rem; }
      .step strong { display: block; margin-bottom: 0.35rem; }
      .step p { margin: 0; color: var(--muted); font-size: 0.9rem; }

      .downloads { margin-top: 2rem; overflow: hidden; border: 1px solid var(--line); border-radius: 1rem; background: var(--surface); }
      .download-row {
        display: grid;
        grid-template-columns: 7rem minmax(0, 1fr) auto;
        gap: 1rem;
        align-items: center;
        min-height: 3.5rem;
        padding: 0.7rem 1rem;
        border-bottom: 1px solid var(--line);
      }
      .download-row:last-child { border-bottom: 0; }
      .platform { color: var(--muted); font-size: 0.8rem; font-weight: 700; text-transform: uppercase; }
      .download-row a { font-weight: 700; text-decoration: none; }
      .download-row small { color: var(--muted); }
      .download-meta { color: var(--muted); font-size: 0.82rem; white-space: nowrap; }
      .release-links { display: flex; flex-wrap: wrap; gap: 0.75rem; margin-top: 1rem; }

      .preservation {
        margin-top: 4.5rem;
        padding: 1.4rem;
        border: 1px solid rgba(115, 168, 255, 0.35);
        border-radius: 1rem;
        background: rgba(115, 168, 255, 0.07);
      }
      .preservation h2 { margin: 0 0 0.45rem; font-size: 1rem; }
      .preservation p { margin: 0; color: var(--muted); font-size: 0.9rem; }

      footer { display: flex; justify-content: space-between; gap: 1rem; padding: 2rem 0 3rem; border-top: 1px solid var(--line); color: var(--muted); font-size: 0.84rem; }
      footer p { margin: 0; }

      @media (max-width: 720px) {
        main { padding-top: 3.5rem; }
        .topbar { align-items: flex-start; padding: 1rem 0; }
        .topbar-links { justify-content: flex-end; }
        .continuity, .steps, .section-head { grid-template-columns: 1fr; }
        .download-row { grid-template-columns: 1fr auto; gap: 0.25rem 1rem; }
        .platform { grid-column: 1 / -1; }
        footer { flex-direction: column; }
      }
    </style>
  </head>
  <body>
    <header class="shell topbar">
      <a class="brand" href={baseUrl}>GoBarryGo</a>
      <nav class="topbar-links" aria-label="Primary">
        <a href="#legacy-downloads">Legacy downloads</a>
        <a href={migrationGuideUrl}>Migration</a>
        <a href={repoUrl}>Source</a>
      </nav>
    </header>

    <main class="shell">
      <div class="hero">
        <span class="eyebrow">Standalone {legacyVersion} preserved</span>
        <h1>GoBarryGo moved forward.</h1>
        <p class="lede">
          Continued development now lives in <strong>ProtoPeek v0.5 Downloader</strong>: the same
          local-first transfer direction inside one broader systems workbench. The standalone
          GoBarryGo release remains available below for anyone who still needs it.
        </p>
        <div class="actions">
          <a class="button button-primary" href={protoPeekUrl}>Open ProtoPeek Downloader</a>
          <a class="button" href={migrationGuideUrl}>Read the migration guide</a>
        </div>
      </div>

      <div class="continuity" aria-label="What changed and what remains">
        <article>
          <span>New home</span>
          <h2>ProtoPeek Downloader</h2>
          <p>New transfer features and maintenance continue in ProtoPeek from v0.5 onward.</p>
        </article>
        <article>
          <span>Kept available</span>
          <h2>GoBarryGo v0.0.9</h2>
          <p>Installers, checksums, tags, screenshots, source, and release history stay public.</p>
        </article>
        <article>
          <span>Safe bridge</span>
          <h2>Preview before import</h2>
          <p>ProtoPeek can preview and copy supported local state without changing GoBarryGo files.</p>
        </article>
      </div>

      <section aria-labelledby="migration-title">
        <div class="section-head">
          <h2 id="migration-title">Move when you are ready.</h2>
          <p>
            GoBarryGo does not disappear when you migrate. Stop both apps, preview the known local
            profile, and apply only after the preview looks right. A guarded rollback remains available.
          </p>
        </div>
        <div class="steps">
          <div class="step"><strong>1. Install ProtoPeek v0.5</strong><p>Use the released package and install a system <code>aria2c</code>; ProtoPeek does not bundle it.</p></div>
          <div class="step"><strong>2. Preview locally</strong><p>Run <code>pp migrate-gobarry</code>. Preview performs no writes.</p></div>
          <div class="step"><strong>3. Import or roll back</strong><p>Use <code>--apply</code> only after review. The receipt supports a guarded rollback.</p></div>
        </div>
        <div class="release-links">
          <a class="button" href={migrationGuideUrl}>GoBarryGo migration steps</a>
          <a class="button" href={canonicalMigrationGuideUrl}>ProtoPeek consolidation contract</a>
        </div>
      </section>

      <section id="legacy-downloads" aria-labelledby="legacy-title">
        <div class="section-head">
          <h2 id="legacy-title">Legacy standalone downloads.</h2>
          <p>
            These are the original {legacyVersion} release assets. Verify the SHA-256 file before
            installing. They remain compatibility downloads, not the path for new feature work.
          </p>
        </div>
        <div class="downloads">
          {legacyDownloads.map((download) => (
            <div class="download-row">
              <span class="platform">{download.platform}</span>
              <a href={`${legacyDownloadBase}/${download.file}`}>
                {download.label}<br /><small>{download.file}</small>
              </a>
              <span class="download-meta">{download.size}</span>
            </div>
          ))}
        </div>
        <div class="release-links">
          <a class="button" href={`${legacyDownloadBase}/checksums.txt`}>SHA-256 checksums</a>
          <a class="button" href={legacyReleaseUrl}>v0.0.9 release notes</a>
          <a class="button" href={`${repoUrl}/releases`}>All GoBarryGo releases</a>
        </div>
      </section>

      <aside class="preservation" aria-labelledby="preservation-title">
        <h2 id="preservation-title">Preservation guarantee</h2>
        <p>
          This transition does not delete or rewrite GoBarryGo source, Git history, tags, release
          binaries, checksums, screenshots, or documentation. The repository remains readable and
          the {legacyVersion} release remains downloadable independently of ProtoPeek.
        </p>
      </aside>
    </main>

    <footer class="shell">
      <p>GoBarryGo and ProtoPeek by <a href={authorUrl}>Shreyam Adhikari</a>.</p>
      <p><a href={repoUrl}>Preserved source</a> · <a href={legacyReleaseUrl}>Legacy release</a></p>
    </footer>
  </body>
</html>
